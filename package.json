{
  "name": "@cap-js/ai",
  "version": "1.2.1",
  "description": "CAP cds-plugin for AI capabilities",
  "homepage": "https://cap.cloud.sap/",
  "license": "Apache-2.0",
  "author": "SAP SE (https://www.sap.com)",
  "repository": "cap-js/ai",
  "bin": {
    "cds-ai": "bin/cds-ai.js"
  },
  "workspaces": [
    "tests/*"
  ],
  "files": [
    ".docs",
    "CHANGELOG.md",
    "bin",
    "lib",
    "srv"
  ],
  "type": "module",
  "main": "cds-plugin.js",
  "scripts": {
    "lint": "npx -y eslint@10 .",
    "test:model:provision": "node tests/provision-model.js",
    "test": "npm run test:model:provision && node --test tests/*.test.js",
    "test:hybrid": "npm run test:model:provision && cds bind --exec -- node --test tests/*.test.js tests/integration/*.test.js",
    "format": "npx -y oxfmt@0.70.0 && format-cds -f",
    "format:check": "npx -y oxfmt@0.70.0 --check && format-cds --check"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/cds-types": "^0.19.0",
    "@cap-js/sqlite": ">=2",
    "@huggingface/hub": "^2.15.0",
    "@huggingface/tokenizers": "^0.2.0",
    "onnxruntime-node": "^1.20.1",
    "oxigraph": "^0.5.9"
  },
  "peerDependencies": {
    "@sap/cds": ">=9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "cds": {
    "requires": {
      "AICore": "AICore-mocked",
      "[production]": {
        "AICore": "AICore-btp"
      },
      "[hybrid]": {
        "AICore": "AICore-btp"
      },
      "kinds": {
        "AICore-mocked": {
          "model": "@cap-js/ai/srv/MockAICoreService"
        },
        "AICore-btp": {
          "model": "@cap-js/ai/srv/AICoreService",
          "resourceGroup": "default",
          "vcap": {
            "label": "aicore"
          }
        },
        "sqlite": {
          "impl": "@cap-js/ai/lib/sqlite/AISQLiteService.js",
          "embedding": {
            "model": "sentence-transformers/all-MiniLM-L6-v2"
          }
        }
      }
    }
  }
}
